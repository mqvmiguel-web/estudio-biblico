#!/usr/bin/env bash
set -euo pipefail
URL="http://127.0.0.1:8765"
PROFILE="$HOME/.local/share/mi-estudio-biblico/chromium-profile"
systemctl --user start mi-estudio-biblico.service
for intento in {1..30}; do
    curl -fsS "$URL/api/books" >/dev/null 2>&1 && break
    sleep 0.25
done
if command -v chromium >/dev/null 2>&1; then
    if command -v kstart >/dev/null 2>&1; then
        exec kstart --maximize chromium --app="$URL" --class=MiEstudioBiblico --window-size=1920,1080 --user-data-dir="$PROFILE"
    else
        exec chromium --app="$URL" --class=MiEstudioBiblico --start-maximized --window-size=1920,1080 --user-data-dir="$PROFILE"
    fi
elif command -v google-chrome-stable >/dev/null 2>&1; then
    if command -v kstart >/dev/null 2>&1; then
        exec kstart --maximize google-chrome-stable --app="$URL" --class=MiEstudioBiblico --window-size=1920,1080 --user-data-dir="$HOME/.local/share/mi-estudio-biblico/chrome-profile"
    else
        exec google-chrome-stable --app="$URL" --class=MiEstudioBiblico --start-maximized --window-size=1920,1080 --user-data-dir="$HOME/.local/share/mi-estudio-biblico/chrome-profile"
    fi
else
    exec firefox --new-window "$URL"
fi
