#!/usr/bin/env bash
systemctl --user start mi-estudio-biblico.service
for intento in {1..20}; do
    if curl -fsS http://127.0.0.1:8765/api/books >/dev/null 2>&1; then
        xdg-open http://127.0.0.1:8765 >/dev/null 2>&1
        exit 0
    fi
    sleep 0.25
done
xdg-open http://127.0.0.1:8765 >/dev/null 2>&1
