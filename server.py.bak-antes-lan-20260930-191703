def save_recording(filename, content, title, mime):
    if not content: raise ValueError("La grabación está vacía")
    if len(content) > 200*1024*1024: raise ValueError("La grabación supera el límite de 200 MB")
    audio_id = uuid.uuid4().hex[:12]
    mime = (mime or "audio/webm").split(";",1)[0].strip().lower()
    extension = {"audio/ogg":".ogg","audio/mp4":".m4a","audio/mpeg":".mp3","audio/wav":".wav"}.get(mime,".webm")
    audio_path = RECORDINGS / f"{audio_id}{extension}"
    audio_path.write_bytes(content)
    meta = {"id":audio_id,"titulo":clean_text(title)[:250] or "Nueva reflexión","archivo":audio_path.name,"mime":mime,"tamano":len(content),"creado":datetime_now(),"duracion":None}
    recording_meta_path(audio_id).write_text(json.dumps(meta,ensure_ascii=False,indent=2),encoding="utf-8")
    return meta

class Handler(SimpleHTTPRequestHandler):
    def translate_path(self, path):
        raw_path = urlparse(path).path
        if raw_path in ('', '/'):
            clean = 'index.html'
        else:
            clean = raw_path.lstrip('/')
        static_root = STATIC.resolve()
        candidate = (static_root / clean).resolve()
        try:
            candidate.relative_to(static_root)
        except ValueError:
            return str(static_root / '__not_found__')
        return str(candidate)

    def send_json(self, value, status=200):
        payload = json.dumps(value, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def read_json(self):
        length = int(self.headers.get("Content-Length", "0"))
        return json.loads(self.rfile.read(length) or b'{}')

    def is_trusted_local_request(self):
        """Allow state-changing requests only from this local app.

        A random website can try to submit forms or fetch requests to
        http://127.0.0.1:8765. Modern browsers include Origin/Referer on
        those unsafe requests, so we reject anything that does not point back
        to this local server. Missing headers are allowed for local tools such
        as curl or maintenance scripts.
        """
        allowed_hosts = {"127.0.0.1", "localhost"}
        allowed_port = PORT

        def valid(value):
            if not value:
                return None
            parsed = urlparse(value)
            return parsed.scheme in {"http", "https"} and parsed.hostname in allowed_hosts and (parsed.port or (443 if parsed.scheme == "https" else 80)) == allowed_port

        origin = self.headers.get("Origin", "")
        referer = self.headers.get("Referer", "")
        if origin:
            return valid(origin)
        if referer:
            return valid(referer)
        return True

    def reject_untrusted_local_request(self):
        if self.is_trusted_local_request():
            return False
        self.send_json({"error":"Solicitud bloqueada: origen no autorizado"}, 403)
        return True

