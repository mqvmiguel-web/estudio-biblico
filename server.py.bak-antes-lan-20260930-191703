def plan_lag(plan):
    """Días de atraso reales. Usa el valor del cliente y, si falta, lo calcula
    el servidor desde la fecha de inicio, así se avisa aunque no se abra la app."""
    try:
        lag = int(plan.get("dias_atraso") or 0)
    except Exception:
        lag = 0
    try:
        inicio = str(plan.get("inicio") or "")[:10]
        if inicio:
            start = datetime.strptime(inicio, "%Y-%m-%d").date()
            esperado = (datetime.now().date() - start).days + 1
            if esperado > 0:
                lag = max(lag, esperado - int(plan.get("dia_actual") or 0))
    except Exception:
        pass
    return max(0, lag)


def plan_name(plan):
    return "Biblia cronológica" if plan.get("modo") == "cronologico" else "Nuevo y Antiguo Testamento"


def plan_dia_esperado(plan):
    """Día del plan que toca hoy, calculado desde la fecha de inicio."""
    try:
        inicio = str(plan.get("inicio") or "")[:10]
        start = datetime.strptime(inicio, "%Y-%m-%d").date()
        return max(1, min(365, (datetime.now().date() - start).days + 1))
    except Exception:
        return 1


def plan_pendientes(plan, limite=25):
    """Lecturas pendientes, calculadas en el servidor a partir del horario del plan.

    Así el correo sabe qué falta aunque el día no se haya abierto la app.
    """
    try:
        datos = json.loads(plan.get("datos") or "{}")
    except Exception:
        datos = {}
    esperado = plan_dia_esperado(plan)
    horario = datos.get("horario")
    if not isinstance(horario, dict) or not horario:
        # Respaldo: lo que mandó el cliente la última vez.
        items = [x for x in (datos.get("pendientes") or []) if isinstance(x, str)][:limite]
        total = int(datos.get("pendientes_total") or len(items))
        hoy = [x for x in items if x.startswith(f"{esperado}|")]
        return {"items": items, "total": total, "hoy": hoy, "hoy_total": len(hoy), "esperado": esperado}
    completadas = set(datos.get("completed") or {})
    items, hoy, total, hoy_total = [], [], 0, 0
    for dia in range(1, esperado + 1):
        for par in (horario.get(str(dia)) or []):
            if not isinstance(par, (list, tuple)) or len(par) < 2:
                continue
            clave, texto = str(par[0]), str(par[1])
            if clave in completadas:
                continue
            trozos = clave.split(":")
            momento = "Noche" if len(trozos) > 1 and trozos[1] == "evening" else "Mañana"
            etiqueta = f"{dia}|{momento}|{texto}"
            total += 1
            if len(items) < limite:
                items.append(etiqueta)
            if dia == esperado:
                hoy_total += 1
                if len(hoy) < limite:
                    hoy.append(etiqueta)
    return {"items": items, "total": total, "hoy": hoy, "hoy_total": hoy_total, "esperado": esperado}


def lista_pendientes(etiquetas, total):
    if not etiquetas:
        return ""
    lineas = []
    for raw in etiquetas:
        partes = raw.split("|")
        if len(partes) == 3:
            dia, momento, texto = partes
            lineas.append(f"• Día {dia} · {momento} — {texto}")
        else:
            lineas.append(f"• {raw}")
    extra = int(total or 0) - len(etiquetas)
    if extra > 0:
        lineas.append(f"• …y {extra} lectura(s) más")
    return "\n".join(lineas)


