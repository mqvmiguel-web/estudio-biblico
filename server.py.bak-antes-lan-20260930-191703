def legibility_profile(text):
    visible = [ch for ch in text if not ch.isspace()]
    if not visible: return (1.0, 0.0, 0.0)
    symbols = sum(ch in SUSPICIOUS_CHARS for ch in visible) / len(visible)
    tokens = re.findall(r"[a-záéíóúüñ]{2,}", text.casefold())
    common = (sum(1 for w in tokens if w in FUNCTION_WORDS) / len(tokens)) if tokens else 0.0
    letters = [ch for ch in text.casefold() if ch.isalpha()]
    vowels = (sum(ch in "aeiouáéíóúü" for ch in letters) / len(letters)) if letters else 0.0
    return symbols, common, vowels

def is_legible_text(text):
    """False cuando el texto viene cifrado/roto y no se puede leer."""
    if not text: return False
    symbols, common, vowels = legibility_profile(text)
    return symbols < 0.06 and common >= 0.05 and vowels >= 0.28

# Caché de páginas: limpiar y normalizar 4 MB en cada búsqueda tardaba segundos.
PAGES_CACHE = {}

def document_pages(meta):
    """Páginas del documento, ya limpias y normalizadas, guardadas en caché."""
    text_name = meta.get("texto")
    if not text_name or not (DOCUMENTS / text_name).is_file():
        raise ValueError("No se pudo leer el texto del documento")
    path = DOCUMENTS / text_name
    firma = f"{path.stat().st_mtime_ns}:{path.stat().st_size}"
    hit = PAGES_CACHE.get(text_name)
    if hit and hit["firma"] == firma:
        return hit["paginas"]
    raw = path.read_text(encoding="utf-8", errors="replace")
    paginas = [{"texto": clean_text(p), "norm": ""} for p in raw.split("\f")]
    for p in paginas:
        p["norm"] = normalize_search(p["texto"])
    if len(PAGES_CACHE) > 2:
        PAGES_CACHE.clear()
    PAGES_CACHE[text_name] = {"firma": firma, "paginas": paginas}
    return paginas

def page_paragraphs(page, pattern, min_len=0, max_len=0):
    """Divide la página y devuelve pares (texto, texto normalizado), con caché."""
    def cumple(t):
        return len(t) >= min_len and (max_len == 0 or len(t) <= max_len)
    clave = f"{pattern}|{min_len}|{max_len}"
    bloques = page.setdefault("bloques", {})
    hit = bloques.get(clave)
    if hit is not None:
        return hit
    partes_t = [p.strip() for p in re.split(pattern, page["texto"])]
    partes_n = [p.strip() for p in re.split(pattern, page["norm"])]
    if len(partes_t) != len(partes_n):  # casofold muy raro: se normaliza aparte
        salida = [(t, normalize_search(t)) for t in partes_t if cumple(t)]
    else:
        salida = [(t, n) for t, n in zip(partes_t, partes_n) if cumple(t)]
    if len(bloques) > 4:
        bloques.clear()
    bloques[clave] = salida
    return salida

_VARIANTES = {"a": "áà", "e": "éè", "i": "íì", "o": "óò", "u": "úù", "n": "ñ"}


def _patron_palabra(palabra):
    """Patrón para hallar una palabra normalizada dentro del texto con acentos."""
    return "".join("[" + c + _VARIANTES.get(c, "") + "]" if c.isalpha() else re.escape(c)
                   for c in palabra)


def tema_principal(meta):
    """Tema del libro: palabras que aparecen en muchas páginas distintas.

    En los comentarios bíblicos las notas de gramática («caso nominativo», «artículo
    determinado») son lo más frecuente; se descartan esos párrafos para que el tema
    refleje el fondo del texto y no la morfología."""
    text_name = meta.get("texto") or ""
    path = DOCUMENTS / text_name
    if not text_name or not path.is_file():
        return []
    firma = f"{path.stat().st_mtime_ns}:{path.stat().st_size}"
    hit = TEMA_CACHE.get(text_name)
    if hit and hit.get("firma") == firma:
        return hit["tema"]
    pages = document_pages(meta)
    paginas_de, original = {}, {}
    min_paginas = max(5, len(pages) // 100)
    for page in pages:
        if not page["texto"]:
            continue
        vistos = set()
        for crudo, norm in page_paragraphs(page, r"\n\s*\n", 80):
            if len(TECNICO_RE.findall(norm)) >= 3:
                continue  # es una nota de sintaxis, no el fondo
            for w in re.findall(r"[a-záéíóúüñ]{4,}", norm):
                if w in FUNCTION_WORDS or w in TERMINOS_TECNICOS:
                    continue
                vistos.add(w)
            if vistos:
                for w in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{4,}", crudo):
                    original.setdefault(normalize_search(w), w)
        for w in vistos:
            paginas_de[w] = paginas_de.get(w, 0) + 1
    orden = sorted((w for w, n in paginas_de.items() if n >= min_paginas),
                   key=lambda w: (paginas_de[w], len(w)), reverse=True)
    tema = [original.get(w, w) for w in orden[:5]]
    if len(TEMA_CACHE) > 4:
        TEMA_CACHE.clear()
    TEMA_CACHE[text_name] = {"firma": firma, "tema": tema}
    return tema


def _salta_inicio_cifrado(texto):
    """Si el fragmento arranca con una cita griega cifrada («KaiV a[/dousin…»),
    se muestra desde la primera frase legible."""
    oraciones = _oraciones(texto)
    if (len(oraciones) > 1 and len(oraciones[0]) < 220
            and not is_legible_text(oraciones[0]) and is_legible_text(oraciones[1])):
        return texto[len(oraciones[0]):].lstrip()
    return texto


def _contexto(paragraph, before, after, palabras=(), limite=1800):
    """Texto mostrado: el párrafo coincidente + sus vecinos, sin pasarse del límite.
    Si el párrafo es más largo que el límite, se corta alrededor de la primera
    palabra que hizo coincidir (antes se cortaba por el principio y el texto
    mostrado no contenía nada que ver con la pregunta)."""
    body = clean_text(paragraph)
    if len(body) >= limite:
        posiciones = []
        for palabra in palabras:
            hit = re.search(_patron_palabra(palabra), body, re.IGNORECASE)
            if hit:
                posiciones.append(hit.start())
        inicio = max(0, min(posiciones) - limite // 4) if posiciones else 0
        return _salta_inicio_cifrado(("…" if inicio else "") + body[inicio:inicio + limite])
    izq, der = clean_text(before), clean_text(after)
    disponible = limite - len(body)
    izq = izq[-min(len(izq), disponible // 2):]
    der = der[:max(0, disponible - len(izq))]
    return _salta_inicio_cifrado(clean_text(" ".join(x for x in (izq, body, der) if x))[:limite])

def search_document_topic(meta, topic):
    topic = clean_text(topic)[:150]
    if len(topic) < 2: raise ValueError("Escribe un tema para analizar")
    text_name = meta.get("texto")
    if not text_name or not (DOCUMENTS / text_name).is_file():
        raise ValueError("El texto completo fue eliminado para liberar espacio; las fichas guardadas siguen disponibles")
    pages = document_pages(meta)
    needle = normalize_search(topic)
    words = search_words(topic)
    required = max(1, (len(words)+1)//2)
    # Palabras poco frecuentes en el documento: con una sola basta. En una pregunta
    # de 4 palabras casi siempre solo una es el tema ("gracia", "autor"...).
    raras = set()
    if len(words) > 1:
        umbral = max(20, len(pages) // 20)
        raras = {w for w in words if sum(1 for p in pages if w in p["norm"]) <= umbral}
    fuertes, debiles, descartados = [], [], 0
    for page_no,page in enumerate(pages,1):
        if not page["texto"]: continue
        bloques = page_paragraphs(page, r"\n\s*\n", 1)
        if len(bloques) <= 1:
            bloques = page_paragraphs(page, r"(?<=[.!?])\s+", 1)
        for idx,(paragraph, normalized) in enumerate(bloques):
            # Un solo barrido: coincide exacta (o todas las palabras) y, si no,
            # la búsqueda flexible con al menos la mitad de las palabras.
            exact = has_word(normalized, needle) if " " not in needle else needle in normalized
            coincidentes = [word for word in words if has_word(normalized, word)]
            matched = len(coincidentes)
            flexible = matched >= required or any(w in raras for w in coincidentes)
            if not (exact or (words and flexible)): continue
            if not is_legible_text(paragraph):
                descartados += 1
                continue
            before = bloques[idx-1][0] if idx > 0 else ""
            after = bloques[idx+1][0] if idx+1 < len(bloques) else ""
            anclas = coincidentes or ([needle] if exact else [])
            context = _contexto(paragraph, before, after, anclas)
            item = {"pagina":page_no,"fragmento":context,
                    "puntaje": (10.0 if exact else 0.0) + matched * 2.0 + min(len(paragraph), 1200) / 1200}
            if exact or matched == len(words):
                fuertes.append(item)
            else:
                debiles.append(item)
        if len(fuertes) >= 40 or len(debiles) >= 60: break
    # Se suman ambos niveles: directos (todas las palabras) y flexibles (al
    # menos la mitad); los dos son evidencia real del documento.
    findings = fuertes + debiles
    findings.sort(key=lambda x: x["puntaje"], reverse=True)
    top = sorted(findings[:12], key=lambda x: x["pagina"])
    joined = "\n\n".join(x["fragmento"] for x in top)
    analysis = analyze_document(joined) if joined else {"resumen":"No se encontraron coincidencias suficientes para este tema.","palabras_clave":[],"referencias":[],"preguntas":[],"bosquejo":[],"caracteres":0,"palabras":0}
    return {"tema":topic,"coincidencias":len(findings),"coincidencias_directas":len(fuertes),"paginas":sorted(set(x["pagina"] for x in findings)),"fragmentos":top,"descartados_cifrados":descartados,"analisis":analysis}

# BIBLIOTECA_INTELIGENTE_LOCAL_V1
def smart_document_fragments(meta, query="", limit=8):
    text_name = meta.get("texto")
    if not text_name or not (DOCUMENTS / text_name).is_file():
        raise ValueError("El texto completo fue eliminado; el análisis guardado sigue disponible, pero no se pueden preparar nuevos fragmentos")

    pages = document_pages(meta)
    query_words = search_words(query)

    # Palabras clave del documento, con peso: las que aparecen en casi todas las
    # páginas son genéricas ("caso", "singular") y pesan menos que las específicas.
    weights = {}
    for k in (meta.get("analisis") or {}).get("palabras_clave", [])[:10]:
        if not isinstance(k, dict): continue
        norm_kw = normalize_search(str(k.get("palabra", "")).strip())
        if not norm_kw or norm_kw in weights: continue
        # Términos gramaticales: en un comentario bíblico dominan y arrastran la
        # selección hacia notas de sintaxis en vez de hacia el fondo del texto.
        if norm_kw in TERMINOS_TECNICOS: continue
        en_paginas = sum(1 for p in pages if norm_kw in p["norm"])
        weights[norm_kw] = 0.35 if en_paginas > max(4, len(pages) * 0.25) else 1.0
    keywords = list(weights)

    terms = {w: "q" for w in query_words}
    for w in keywords:
        terms.setdefault(w, "k")
    matcher = None
    if terms:
        alt = "|".join(re.escape(t) for t in sorted(terms, key=len, reverse=True))
        matcher = re.compile(r"(?<![a-z0-9])(?:" + alt + r")(?![a-z0-9])")

    candidates = []
    total_pages = max(1, len(pages))
    for page_no, page in enumerate(pages, 1):
        if not page["texto"]:
            continue
        # Por párrafo (no por frase): separar en frases parte las referencias
        # ("Is. 53:7" quedaría como "Is." + "53:7") y se pierde el bono de citas.
        paragraphs = page_paragraphs(page, r"\n\s*\n", 80)
        for idx, (paragraph, norm) in enumerate(paragraphs):
            hits = set(matcher.findall(norm)) if matcher else set()
            qscore = sum(6 for w in hits if terms.get(w) == "q")
            # Las palabras clave aportan poco: en comentarios bíblicos dominan los
            # términos gramaticales (caso, artículo, singular) y eso tapa el fondo.
            kscore = min(1.5, sum(weights.get(w, 1.0) for w in hits if terms.get(w) == "k"))
            refs = len(BOOK_REF_RE.findall(norm)) if REF_HINT_RE.search(norm) else 0
            refscore = min(3.0, 1.5 * refs)
            spread_bonus = 1.0 - abs((page_no / total_pages) - 0.5) * 0.15
            score = (qscore + kscore + refscore + min(len(paragraph), 1200) / 1200) * spread_bonus
            # Se penaliza si el fragmento arranca en texto cifrado/griego o a
            # media frase: la evidencia tiene que empezar por algo legible.
            primera = re.split(r"(?<=[.!?])\s+", paragraph, maxsplit=1)[0]
            primera_letra = next((c for c in primera if c.isalpha()), "")
            if (len(primera) < 40 or not is_legible_text(primera)
                    or primera_letra.islower()):
                score *= 0.8
            # Las notas de gramática son útiles, pero no son el fondo del texto.
            if len(TECNICO_RE.findall(norm)) >= 3:
                score *= 0.72
            if "...." in paragraph:
                score *= 0.5   # línea de índice («16- ¿Está la salvación?….. (191)»)
            if score <= 0:
                continue
            candidates.append((score, page_no, idx, paragraph[:1800]))

    if not candidates:
        raise ValueError("No se encontró texto suficiente para preparar el análisis")

    candidates.sort(key=lambda x: x[0], reverse=True)

    # Se prefiere texto legible: los párrafos cifrados solo entran como respaldo.
    legibles, respaldo, usadas, revisados = [], [], set(), 0
    for score, page_no, idx, paragraph in candidates:
        if len(legibles) >= limit and len(respaldo) >= limit:
            break
        if page_no in usadas:
            continue
        if revisados >= 400:
            break
        revisados += 1
        usadas.add(page_no)
        if is_legible_text(paragraph):
            if len(legibles) < limit:
                legibles.append((score, page_no, idx, paragraph))
        elif len(respaldo) < limit:
            respaldo.append((score, page_no, idx, paragraph))

    picked = legibles[:limit]
    if len(picked) < limit:
        picked += respaldo[:limit - len(picked)]
    if len(picked) < limit:
        elegidos = {(x[1], x[3]) for x in picked}
        for item in candidates:
            if len(picked) >= limit:
                break
            if (item[1], item[3]) in elegidos:
                continue
            elegidos.add((item[1], item[3]))
            picked.append(item)

    selected = [{"pagina": p, "fragmento": _salta_inicio_cifrado(t), "puntaje_local": round(s, 2)} for s, p, _, t in picked]
    selected.sort(key=lambda x: x["pagina"])
    return selected


def _oraciones(text):
    """Divide en frases sin cortar citas bíblicas («Is. 53:7» no se parte en «Is.»)."""
    partes = re.split(r"(?<=[.!?])\s+", str(text or "").strip())
    salida = []
    for parte in partes:
        parte = parte.strip()
        if (salida and re.search(r"[\s(][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{1,3}\.$", salida[-1])
                and re.match(r"\d", parte)):
            salida[-1] = salida[-1] + " " + parte
        else:
            salida.append(parte)
    return salida


def _first_sentences(text, max_len=600):
    """Primera frase con contenido, recortada en límite de palabra."""
    for sentence in _oraciones(text):
        sentence = " ".join(sentence.split())
        if len(sentence) >= 40:
            if len(sentence) > max_len:
                sentence = sentence[:max_len].rsplit(" ", 1)[0] + "…"
            return sentence
    return ""


# Caché del análisis previo: no depende de la pregunta, solo del documento,
# así que desde la segunda vez se responde al tiro en vez de rebarrer 1000+ páginas.
SMART_PREVIEW_CACHE = {}

def build_local_smart_preview(meta):
    text_name = meta.get("texto") or ""
    path = DOCUMENTS / text_name if text_name else None
    firma = f"{path.stat().st_mtime_ns}:{path.stat().st_size}" if path and path.is_file() else ""
    if firma:
        hit = SMART_PREVIEW_CACHE.get(text_name)
        if hit and hit.get("firma") == firma:
            return hit["resultado"]
    resultado = _build_local_smart_preview(meta)
    if firma:
        if len(SMART_PREVIEW_CACHE) > 4:
            SMART_PREVIEW_CACHE.clear()
        SMART_PREVIEW_CACHE[text_name] = {"firma": firma, "resultado": resultado}
    return resultado


def _build_local_smart_preview(meta):
    analysis = meta.get("analisis") or {}
    keywords_all = [k.get("palabra") for k in analysis.get("palabras_clave", [])[:5] if isinstance(k, dict) and k.get("palabra")]
    # Una palabra con símbolos raros viene de texto cifrado y no aporta nada.
    keywords = [k for k in keywords_all if re.fullmatch(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ0-9 .-]{2,30}", k)]
    outline = [x.get("idea") for x in analysis.get("bosquejo", []) if isinstance(x, dict) and x.get("idea")]
    summary = str(analysis.get("resumen") or "").strip()
    fragments = smart_document_fragments(meta, "", 8)
    legibles = [f for f in fragments if is_legible_text(f.get("fragmento", ""))]

    # Las palabras clave guardadas vienen del análisis general, que en estos
    # documentos quedó cifrado («caso, singular, kaiv»). Si ese análisis se omitió,
    # el tema provisional se deriva de los fragmentos legibles ya seleccionados.
    # El tema principal sale de la frecuencia entre páginas distintas, que es lo
    # que dice de qué trata el libro (no de las notas de gramática).
    tema = tema_principal(meta)
    if tema:
        keywords = tema
    elif meta.get("analisis_general_omitido") or not keywords:
        ocurrencias, paginas_de, original = {}, {}, {}
        for f in legibles:
            crudo = str(f.get("fragmento") or "")
            for w in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{4,}", crudo):
                n = normalize_search(w)
                if n in FUNCTION_WORDS:
                    continue
                ocurrencias[n] = ocurrencias.get(n, 0) + 1
                original.setdefault(n, w)
            for n in set(normalize_search(w) for w in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{4,}", crudo)):
                if n in FUNCTION_WORDS:
                    continue
                paginas_de[n] = paginas_de.get(n, 0) + 1
        orden = sorted(ocurrencias, key=lambda w: (paginas_de.get(w, 0), ocurrencias[w], len(w)), reverse=True)
        keywords = [original.get(w, w) for w in orden[:5]]
    # El tema del libro no es "caso, verbo, singular": esos términos se descartan
    # (salvo que no quede nada mejor).
    utiles = [k for k in keywords if normalize_search(k) not in TERMINOS_TECNICOS]
    keywords = utiles or keywords

    # El resumen guardado solo sirve si el documento pasó el control de calidad.
    central = ""
    if not meta.get("analisis_general_omitido"):
        for sentence in re.split(r"(?<=[.!?])\s+", summary):
            if len(sentence.strip()) >= 60 and is_legible_text(sentence):
                central = sentence.strip()[:700]
                break
    if not central and legibles:
        # Se prefiere el fragmento que cita versículos: es el que comenta el texto bíblico.
        best = max(legibles, key=lambda f: (len(BOOK_REF_RE.findall(f.get("fragmento", ""))), f.get("puntaje_local") or 0))
        central = _first_sentences(best.get("fragmento"), 700)

    # En libros grandes el bosquejo guardado son líneas de índice («Mensaje a la
    # iglesia en Pérgamo (2:12-17) 169»), no ideas: se derivan de los fragmentos.
    ideas = [] if meta.get("analisis_general_omitido") else \
        [i for i in outline if len(i) >= 30 and is_legible_text(i)][:5]
    if not ideas:
        for f in legibles:
            # Frase a frase: el fragmento puede ser legible y su primera línea griega no.
            for sentence in _oraciones(f.get("fragmento", "")):
                if len(sentence) < 40 or not is_legible_text(sentence):
                    continue
                idea = _first_sentences(sentence, 220)
                if idea and idea not in ideas:
                    ideas.append(idea)
                break
            if len(ideas) >= 3:
                break

    avisos = ["Preparación local completada. Ningún texto fue enviado a Internet."]
    if not legibles:
        avisos.append("⚠️ El texto interno de estas páginas está cifrado/ilegible: no se pudieron derivar resumen ni ideas.")
    elif len(legibles) < len(fragments):
        avisos.append(f"⚠️ {len(fragments) - len(legibles)} de {len(fragments)} fragmentos venían cifrados y se descartaron.")

    return {
        "modo": "local",
        "ia_conectada": False,
        "tema_principal_provisional": ", ".join(keywords[:3]) if keywords else "Por determinar con IA",
        "punto_central_provisional": central or "No disponible: el texto de estas páginas está cifrado.",
        "ideas_provisionales": ideas,
        "referencias": analysis.get("referencias", [])[:20],
        "fragmentos": fragments,
        "calidad_extraccion": meta.get("calidad_extraccion", ""),
        "aviso": " ".join(avisos)
    }


def _respuesta_local(fragments, question):
    """Párrafo de respuesta armado localmente con las oraciones que responden."""
    words = search_words(question, 3)
    if not words:
        return ""
    oraciones = []
    for f in fragments:
        for s in _oraciones(f.get("fragmento", "")):
            s = " ".join(s.split())
            if len(s) < 45 or len(s) > 420 or not is_legible_text(s):
                continue
            oraciones.append(s)

    def puntaje(s):
        norm = normalize_search(s)
        return sum(1 for w in words if w in norm)

    elegidas, vistas, largo = [], set(), 0
    for s in sorted(oraciones, key=puntaje, reverse=True):
        if puntaje(s) <= 0:
            break
        clave = normalize_search(s)[:80]
        if clave in vistas:
            continue
        vistas.add(clave)
        elegidas.append(s)
        largo += len(s)
        if len(elegidas) >= 3 or largo > 750:
            break
    return " ".join(elegidas)


def _preguntas_seguimiento(question, fragments, respuesta):
    """Tres preguntas para seguir trabajando el tema, en lenguaje del usuario."""
    genericas = {"ensena", "ensenar", "dice", "decir", "habla", "hablar", "menciona",
                 "mencionar", "explica", "explicar", "significa", "quiere", "mostrar",
                 "muestra", "autor", "documento", "texto", "libro", "pagina",
                 "acerca", "respecto", "segun", "puede", "debe", "sabe"}
    words = [w for w in search_words(question, 4) if len(w) >= 4]
    hay = normalize_search((respuesta or "") + " " + " ".join(str(f.get("fragmento") or "") for f in fragments))
    candidatos = [w for w in words if w in hay] or words
    if not candidatos:
        candidatos = [w for w in re.findall(r"[a-záéíóúüñ]{4,}", hay)][:1] or ["el texto"]

    def cuenta(w):
        return len(re.findall(r"(?<![a-z0-9])" + re.escape(w) + r"(?![a-z0-9])", hay))

    # Lo más repetido en el documento es el tema de verdad; los verbos de la
    # pregunta ("enseña", "dice") solo empañan las preguntas de seguimiento.
    ordenados = sorted((w for w in candidatos if w not in genericas),
                       key=lambda w: (-cuenta(w), -len(w))) or candidatos
    tema_norm = ordenados[0]
    original = None
    for tok in re.findall(r"[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]{4,}", question):
        if normalize_search(tok) == tema_norm:
            original = tok
            break
    tema = original or tema_norm.capitalize()
    return [
        f"¿Qué papel juega «{tema}» en el documento?",
        f"¿Qué pasajes bíblicos apoyan lo que dice acerca de «{tema}»?",
        f"¿Cómo aplicarías «{tema}» en la vida diaria?",
    ]


def build_local_question_preview(meta, question):
    question = clean_text(str(question or ""))[:500]
    if len(question) < 3:
        raise ValueError("Escribe una pregunta sobre el documento")

    result = search_document_topic(meta, question)
    # Para una pregunta el orden útil es por relevancia (no por página).
    fragments = sorted(result.get("fragmentos") or [],
                       key=lambda x: float(x.get("puntaje") or x.get("puntaje_local") or 0),
                       reverse=True)[:8]
    descartados = int(result.get("descartados_cifrados") or 0)
    coincidencias = int(result.get("coincidencias") or 0)
    directas = int(result.get("coincidencias_directas") or 0)

    if not fragments:
        words = search_words(question, 4)
        if words:
            fragments = sorted(smart_document_fragments(meta, " ".join(words[:8]), 8),
                               key=lambda x: float(x.get("puntaje_local") or 0), reverse=True)

    if directas:
        aviso = "Evidencia local encontrada. Estos fragmentos se enviarían a la IA cuando activemos la segunda etapa."
    elif coincidencias:
        aviso = "Solo coincidencias parciales: los fragmentos comparten parte de las palabras de tu pregunta."
    elif fragments:
        aviso = "No hubo coincidencias exactas con tu pregunta; estos son los fragmentos más relacionados del documento."
    else:
        aviso = "No se encontró evidencia legible para esta pregunta. Prueba con «Preparar análisis» o con otra parte del documento."
    if descartados:
        aviso += f" Se descartaron {descartados} fragmentos con texto ilegible."

    respuesta = _respuesta_local(fragments, question)

    return {
        "modo": "local",
        "ia_conectada": False,
        "pregunta": question,
        "coincidencias": coincidencias,
        "directo": bool(directas),
        "paginas": sorted(set(int(x.get("pagina", 0)) for x in fragments if x.get("pagina"))),
        "fragmentos": fragments,
        "aviso": aviso,
        "respuesta_local": respuesta,
        "seguimiento": _preguntas_seguimiento(question, fragments, respuesta)
    }

