MESES_CORTO = ["ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"]


def plan_period_stats(plan, start, end):
    """Lecturas marcadas (con hora) dentro de un período y días en que se leyó."""
    try:
        datos = json.loads(plan.get("datos") or "{}")
    except Exception:
        datos = {}
    stamps = datos.get("stamps") if isinstance(datos, dict) else None
    if not isinstance(stamps, dict):
        stamps = {}
    desde, hasta = start.strftime("%Y-%m-%d"), end.strftime("%Y-%m-%d")
    por_dia = {}
    for marca in stamps.values():
        fecha = str(marca or "")[:10]
        if desde <= fecha <= hasta:
            por_dia[fecha] = por_dia.get(fecha, 0) + 1
    return {"lecturas": sum(por_dia.values()), "dias": sorted(por_dia)}


def lista_dias(dias, limite=12):
    if not dias:
        return ""
    etiquetas = []
    for fecha in dias:
        partes = str(fecha).split("-")
        try:
            etiquetas.append(f"{int(partes[2])} {MESES_CORTO[int(partes[1])-1]}")
        except Exception:
            etiquetas.append(str(fecha))
    extra = len(etiquetas) - limite
    if extra > 0:
        etiquetas = etiquetas[:limite] + [f"…+{extra}"]
    return ", ".join(etiquetas)


def texto_delta(actual, previo):
    delta = int(actual) - int(previo)
    return f"+{delta}" if delta > 0 else (str(delta) if delta < 0 else "=")


def build_report(kind="monthly", now=None):
    now = now or datetime.now()
    if kind == "weekly":
        start = (now - timedelta(days=6)).date(); end = now.date()
        prev_end = start - timedelta(days=1); prev_start = prev_end - timedelta(days=6)
        title = "Resumen semanal"; comparacion = "la semana anterior"
    else:
        end = now.date().replace(day=1) - timedelta(days=1)
        start = end.replace(day=1)
        prev_end = start - timedelta(days=1); prev_start = prev_end.replace(day=1)
        title = "Informe mensual"; comparacion = "el mes anterior"
    stats = period_stats(start, end); prev = period_stats(prev_start, prev_end)
    verse = report_verse(end.toordinal())
    plan_text = []
    for plan in stats["planes"]:
        total = int(plan.get("total") or 0); done = int(plan.get("completadas") or 0)
        pct = round(100*done/total) if total else 0
        name = "Biblia cronológica" if plan.get("modo") == "cronologico" else "Nuevo y Antiguo Testamento"
        act = plan_period_stats(plan, start, end); ant = plan_period_stats(plan, prev_start, prev_end)
        plan_text.append(f"• {name}: {act['lecturas']} lectura(s) en el período (anterior: {ant['lecturas']}) · {done} de {total} en total ({pct} %)")
        if act["dias"]:
