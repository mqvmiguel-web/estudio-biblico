            match_pdf = re.fullmatch(r"/api/documents/([a-f0-9]{12})/pdf", u.path)
            if match_pdf:
                # VISOR_PDF_RANGOS_V1: rangos HTTP (206) para que PDF.js pida solo
                # los trozos que necesita en vez del archivo completo. Sin Range se
                # sirve entero (200) como antes. Se transmite por tramos desde disco
                # para no cargar PDFs grandes completos en memoria.
                # La ficha se lee directo (sin reclasificar): pdfinfo + leer el txt
                # + reescribir el json costaban ~130 ms por petición y con cientos
                # de trozos sumaban minutos. Aquí basta el nombre del archivo.
                doc_id = match_pdf.group(1)
                meta_path = document_meta_path(doc_id)
                if not meta_path.is_file():
                    raise ValueError("Documento no encontrado")
                meta = json.loads(meta_path.read_text(encoding="utf-8"))
                archivo = meta.get("archivo")
                path = DOCUMENTS / archivo if archivo else None
                if not archivo or not path.is_file():
                    raise ValueError("Documento no encontrado")
                nombre = meta.get("nombre") or "documento.pdf"
                size = path.stat().st_size
                start, end = 0, size - 1
                parcial = False
                rng = self.headers.get("Range")
                if rng and rng.startswith("bytes="):
                    try:
                        spec = rng.split("=", 1)[1].split(",")[0].strip()
                        a, _, b = spec.partition("-")
                        if a:
                            start = int(a)
                            end = int(b) if b else size - 1
                            if start >= size:
                                raise ValueError
                            end = min(end, size - 1)
                        elif b:
                            start = max(0, size - int(b))
                            end = size - 1
                        else:
                            raise ValueError
                        if start > end:
                            raise ValueError
                        parcial = True
                    except ValueError:
                        start, end = 0, size - 1
                        parcial = False
                length = end - start + 1
                self.send_response(206 if parcial else 200)
                self.send_header("Content-Type", "application/pdf")
                self.send_header("Accept-Ranges", "bytes")
                if parcial:
                    self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
                self.send_header("Content-Length", str(length))
                self.send_header("Content-Disposition", f'inline; filename="{nombre}"')
                self.end_headers()
                with open(path, "rb") as f:
                    f.seek(start)
                    restante = length
                    while restante > 0:
                        trozo = f.read(min(65536, restante))
                        if not trozo:
                            break
                        self.wfile.write(trozo)
                        restante -= len(trozo)
                return
            return super().do_GET()
        except Exception as exc:
            return self.send_json({"error": str(exc)}, 400)

