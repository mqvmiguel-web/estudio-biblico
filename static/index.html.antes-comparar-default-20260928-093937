let mediaRecorder=null,recordedChunks=[],recordingBlob=null,recordingStream=null,recordingSeconds=0,recordingTimer=null;
function supportedAudioType(){for(let type of ['audio/ogg;codecs=opus','audio/webm;codecs=opus','audio/webm'])if(MediaRecorder.isTypeSupported(type))return type;return ''}
async function startRecording(){try{discardRecording(false);recordingStream=await navigator.mediaDevices.getUserMedia({audio:{deviceId:preachMicDeviceId?{exact:preachMicDeviceId}:undefined,echoCancellation:true,noiseSuppression:true}});let type=supportedAudioType(),options=type?{mimeType:type}:undefined;mediaRecorder=new MediaRecorder(recordingStream,options);recordedChunks=[];mediaRecorder.ondataavailable=e=>{if(e.data&&e.data.size)recordedChunks.push(e.data)};mediaRecorder.onstop=prepareRecordingPreview;mediaRecorder.start(1000);recordingSeconds=0;updateRecordingTime();recordingTimer=setInterval(()=>{recordingSeconds++;updateRecordingTime()},1000);recordingPulse.classList.add('live');recordingState.textContent='Grabando…';recordButton.disabled=true;pauseButton.disabled=false;stopButton.disabled=false;recordingMessage.textContent='Habla con normalidad. Puedes pausar y continuar.'}catch(e){recordingMessage.textContent='No fue posible usar el micrófono: '+e.message}}
function pauseRecording(){if(!mediaRecorder)return;if(mediaRecorder.state==='recording'){mediaRecorder.pause();pauseButton.textContent='Continuar';recordingState.textContent='Grabación pausada';recordingPulse.classList.remove('live');clearInterval(recordingTimer)}else if(mediaRecorder.state==='paused'){mediaRecorder.resume();pauseButton.textContent='Pausar';recordingState.textContent='Grabando…';recordingPulse.classList.add('live');recordingTimer=setInterval(()=>{recordingSeconds++;updateRecordingTime()},1000)}}
function stopRecording(){if(!mediaRecorder||mediaRecorder.state==='inactive')return;clearInterval(recordingTimer);mediaRecorder.stop();recordingStream?.getTracks().forEach(t=>t.stop());recordingPulse.classList.remove('live');recordingState.textContent='Grabación terminada';pauseButton.disabled=true;stopButton.disabled=true;recordButton.disabled=false}
function updateRecordingTime(){recordingTime.textContent=String(Math.floor(recordingSeconds/60)).padStart(2,'0')+':'+String(recordingSeconds%60).padStart(2,'0')}
function prepareRecordingPreview(){let type=mediaRecorder?.mimeType||supportedAudioType()||'audio/webm';recordingBlob=new Blob(recordedChunks,{type});previewAudio.src=URL.createObjectURL(recordingBlob);recordingPreview.hidden=false;recordingMessage.textContent='Escucha la grabación antes de guardarla.'}
function discardRecording(resetMessage=true){if(mediaRecorder&&mediaRecorder.state!=='inactive')mediaRecorder.stop();recordingStream?.getTracks().forEach(t=>t.stop());clearInterval(recordingTimer);if(previewAudio?.src)URL.revokeObjectURL(previewAudio.src);recordingBlob=null;recordedChunks=[];recordingPreview.hidden=true;recordingPulse.classList.remove('live');recordButton.disabled=false;pauseButton.disabled=true;stopButton.disabled=true;pauseButton.textContent='Pausar';recordingState.textContent='Listo para grabar';recordingSeconds=0;updateRecordingTime();if(resetMessage)recordingMessage.textContent='Grabación descartada.'}
async function saveRecording(){if(!recordingBlob)return;let title=recordingTitle.value.trim()||'Nueva reflexión';recordingMessage.className='saving-audio';recordingMessage.textContent='Guardando grabación…';let ext=recordingBlob.type.includes('ogg')?'ogg':'webm',form=new FormData();form.append('titulo',title);form.append('audio',recordingBlob,`grabacion.${ext}`);try{let response=await fetch('/api/recordings',{method:'POST',body:form}),data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo guardar');discardRecording(false);recordingTitle.value='';recordingMessage.className='muted';recordingMessage.textContent='Grabación guardada correctamente ✓';await loadRecordings()}catch(e){recordingMessage.className='muted';recordingMessage.textContent='Error: '+e.message}}

function cleanRecordingTitle(title){
  return String(title||"").replace(/�+/g,"-").replace(/\s+-\s+/g," - ").replace(/\s{2,}/g," ").trim();
}
function formatAudioTime(seconds){
  seconds=Number.isFinite(seconds)?Math.max(0,Math.floor(seconds)):0;
  return String(Math.floor(seconds/60)).padStart(2,'0')+':'+String(seconds%60).padStart(2,'0');
}
function updateRecordingPlayer(audio){
  let row=audio.closest('.recording-row');
  if(!row)return;
  let bar=row.querySelector('.recording-progress-fill');
  let time=row.querySelector('.recording-current-time');
  let duration=row.querySelector('.recording-duration-time');
  if(time)time.textContent=formatAudioTime(audio.currentTime);
  if(duration&&Number.isFinite(audio.duration))duration.textContent=formatAudioTime(audio.duration);
  if(bar){
    let pct=audio.duration&&Number.isFinite(audio.duration)?(audio.currentTime/audio.duration*100):0;
    bar.style.width=Math.max(0,Math.min(100,pct))+'%';
  }
}
function seekRecording(event,track){
  let row=track.closest('.recording-row');
  let audio=row?.querySelector('audio');
  if(!audio||!Number.isFinite(audio.duration)||audio.duration<=0)return;
  let rect=track.getBoundingClientRect();
  let x=(event.clientX??event.touches?.[0]?.clientX)-rect.left;
  let pct=Math.max(0,Math.min(1,x/rect.width));
  audio.currentTime=pct*audio.duration;
  updateRecordingPlayer(audio);
}
function startRecordingSeek(event,track){
  seekRecording(event,track);
  const move=e=>seekRecording(e,track);
  const up=()=>{window.removeEventListener('mousemove',move);window.removeEventListener('mouseup',up)};
  window.addEventListener('mousemove',move);
  window.addEventListener('mouseup',up,{once:true});
}
function toggleRecordingPlayback(button){
  let row=button.closest('.recording-row');
  let audio=row?.querySelector('audio');
  if(!audio)return;
  document.querySelectorAll('.recording-row audio').forEach(a=>{if(a!==audio){a.pause();let b=a.closest('.recording-row')?.querySelector('.recording-play-button');if(b)b.textContent='Reproducir'}});
