function setupProjectorSync(){
  if(projectorChannel)return;
  if(!('BroadcastChannel' in window))return;
  projectorChannel=new BroadcastChannel('mi-estudio-biblico-proyector');
  projectorChannel.onmessage=event=>{
    let msg=event.data||{};
    if(!isProjectorWindow){
      if(msg.type==='bye'){projectorWindowRef=null;setProjectorButtonState(false);if(!preachOverlay.hidden)closePreachingMode()}
      return;
    }
    if(String(msg.presentationId||'')!==String(activePresentation||''))return;
    if(msg.type==='state'){
      preachSlide=Math.max(0,Math.min(preachSlides.length-1,Number(msg.slide)||0));
      slideJustified=!!msg.justified;
      slideCentered=!!msg.centered;
      if(msg.slideFontSize)slideReadingSize=Number(msg.slideFontSize)||slideReadingSize;
      if(preachMode!==msg.mode)setPreachingMode(msg.mode||'slides');
      else if(preachMode==='slides')renderSlide(false);
    }
    if(msg.type==='close')closePreachingMode();
  };
}

function broadcastProjectorState(){
  if(isProjectorWindow)return;
  setupProjectorSync();
  if(!projectorChannel||!activePresentation)return;
  projectorChannel.postMessage({
    type:'state',
    presentationId:activePresentation,
    slide:preachSlide,
    mode:preachMode,
    justified:slideJustified,
    centered:slideCentered,
    slideFontSize:slideReadingSize
  });
}

