    :"";

  slideStage.innerHTML=`
    <article class="slide-card ${slideJustified?'slide-justified':''} ${slideCentered?'slide-centered':''}" style="position:relative">
      ${editButton}
      <div class="slide-context">
        <span class="slide-context-base">📖 ${escapeHtml(s.baseText||s.kicker||"")}</span>
