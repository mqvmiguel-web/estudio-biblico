function protectBibleReferences(text){
  return String(text||"")
    .replace(/\b([123])\s+(de\s+)?(?=(?:corintios|tesalonicenses|timoteo|pedro|juan|samuel|reyes|cr[oó]nicas)\b)/gi,(m,n,de)=>n+"\u00a0"+(de||""))
    .replace(/\b([123])\s+(?=(?:Co|Cor|Corintios|Ts|Tes|Tesalonicenses|Ti|Tim|Timoteo|P|Pe|Pedro|Jn|Juan|S|Sam|Samuel|R|Re|Reyes|Cr|Cron|Crónicas)\b)/g,"$1\u00a0");
}

function splitLongSlideUnit(unit,max){
  let parts=[],text=String(unit||"").trim();
  while(text.length>max){
    let cut=Math.max(text.lastIndexOf(". ",max),text.lastIndexOf("; ",max),text.lastIndexOf(": ",max),text.lastIndexOf(", ",max),text.lastIndexOf("\n",max),text.lastIndexOf(" ",max));
    if(cut<Math.floor(max*.55))cut=max;
    let part=text.slice(0,cut+1).trim();
    text=text.slice(cut+1).trim();
    if(part)parts.push(part);
  }
  if(text)parts.push(text);
  return parts;
}

function splitTextForSlides(text,max=430){
  text=protectBibleReferences(text).trim();
  if(!text)return [];
  if(text.length<=max)return [text];
  let units=[];
  for(let paragraph of text.split(/\n\s*\n/).map(x=>x.trim()).filter(Boolean)){
    let pieces=paragraph.match(/[^.!?;:]+[.!?;:]+(?:["”’])?|[^.!?;:]+$/g)||[paragraph];
    pieces.forEach(piece=>{
      piece=piece.trim();
      if(piece)units.push(piece);
    });
    units.push("\n\n");
  }
  if(units[units.length-1]==="\n\n")units.pop();
  let slides=[],current="";
  for(let unit of units){
    let sep=unit==="\n\n"?"\n\n":(current&& !current.endsWith("\n\n")?" ":"");
    if(unit!=="\n\n" && (current+sep+unit).length<=max){
      current+=sep+unit;
      continue;
    }
    if(current.trim())slides.push(current.trim());
    current="";
    if(unit==="\n\n")continue;
    if(unit.length>max)slides.push(...splitLongSlideUnit(unit,max));
    else current=unit;
  }
  if(current.trim())slides.push(current.trim());
  return slides.filter(Boolean);
}

function buildSlides(p){
  let sermonTitle=p.titulo||"Nueva predicación";
  let baseText=p.texto_base||"Mi Estudio Bíblico";
  let slides=[{kicker:baseText,title:sermonTitle,text:"",noteKey:"title",sermonTitle,baseText,sectionLabel:"Mensaje principal"}];
  let sections=[];
  if(p.idea_central)sections.push(["Idea central",p.idea_central,"idea"]);
  if(p.introduccion)sections.push(["Introducción",p.introduccion,"intro"]);
  (p.puntos||[]).forEach((point,index)=>{let q=parseMainPoint(point,index);sections.push(["Punto "+(index+1)+": "+q.title,q.text,"point_"+(index+1)])});
  if(p.aplicacion)sections.push([p.titulo_aplicacion||"¿Qué es lo que debo hacer?",p.aplicacion,"application"]);
  if(p.conclusion)sections.push(["Conclusión y llamado",p.conclusion,"conclusion"]);
  sections.forEach(([title,text,noteKey])=>{
    let partes=splitTextForSlides(text,430);
    if(!partes.length)return;
    partes.forEach((parte,i)=>slides.push({
      kicker:title,
      title:partes.length>1?title+" · "+(i+1)+"/"+partes.length:title,
      text:parte,
      noteKey:noteKey,
      sermonTitle,
      baseText,
      sectionLabel:title
    }));
  });
  return slides;
}

