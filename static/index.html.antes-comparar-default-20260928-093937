    if(!card)return;

    let notes=document.getElementById("privateNotesBox");

    /*
      Área real disponible:
      - arriba: debajo de la barra
      - abajo: dejamos sitio para las flechas
      - derecha: termina ANTES del panel de notas
    */
    let left=44;
    let top=12;
    let bottom=62;
    let right=44;

    if(notes){
      let nr=notes.getBoundingClientRect();
      right=Math.max(44,window.innerWidth-nr.left+28);
    }

    slideStage.style.setProperty("position","absolute","important");
    slideStage.style.setProperty("left","0","important");
    slideStage.style.setProperty("right","0","important");
    slideStage.style.setProperty("top","52px","important");
    slideStage.style.setProperty("bottom","0","important");
    slideStage.style.setProperty("width","auto","important");
    slideStage.style.setProperty("height","auto","important");
    slideStage.style.setProperty("padding",
      top+"px "+right+"px "+bottom+"px "+left+"px","important");
    slideStage.style.setProperty("box-sizing","border-box","important");
    slideStage.style.setProperty("display","flex","important");
    slideStage.style.setProperty("align-items","stretch","important");
    slideStage.style.setProperty("justify-content","center","important");

    let cs=getComputedStyle(slideStage);

    let availableHeight=
      slideStage.clientHeight
      -parseFloat(cs.paddingTop)
      -parseFloat(cs.paddingBottom);

    card.style.setProperty("width","100%","important");
    card.style.setProperty("max-width","none","important");
    card.style.setProperty("margin","0","important");
    card.style.setProperty("box-sizing","border-box","important");
    card.style.setProperty("text-align",slideJustified?"left":"center","important");
    card.style.setProperty("display","flex","important");
    card.style.setProperty("flex-direction","column","important");
    card.style.setProperty("justify-content","center","important");
    card.style.setProperty("min-height",Math.max(420,Math.round(availableHeight*0.92))+"px","important");

    if(title){
      let titleSize=text?76:86;
      title.style.setProperty("font-size",titleSize+"px","important");
      title.style.setProperty("line-height","1.04","important");
      title.style.setProperty("max-width","100%","important");
      title.style.setProperty("text-align",slideJustified?"left":"center","important");
      title.style.setProperty("margin","0 auto "+(text?"24px":"10px"),"important");
    }

    if(text){
      /*
        A- / A+ mandan sobre el tamaño de la letra.
        El sistema NO vuelve a agrandarla automáticamente.
        Sólo la reduce si físicamente no cabe.
      */
      let size=slideReadingSize;

      text.style.setProperty("width","100%","important");
      text.style.setProperty("max-width","none","important");
      text.style.setProperty("text-align",slideJustified?"justify":"center","important");
      text.style.setProperty("text-wrap",slideJustified?"pretty":"balance","important");
      text.style.setProperty("font-size",size+"px","important");
      text.style.setProperty("line-height","1.30","important");
      text.style.setProperty("margin-top","24px","important");
      text.style.setProperty("margin-bottom","24px","important");

      while(card.scrollHeight>availableHeight && size>16){
        size-=1;
        text.style.setProperty("font-size",size+"px","important");
      }

      if(card.scrollHeight>availableHeight && title){
        let ts=parseFloat(getComputedStyle(title).fontSize);

        while(card.scrollHeight>availableHeight && ts>30){
          ts-=2;
          title.style.setProperty("font-size",ts+"px","important");
        }
      }
    }

    if(!text && title){
      let ts=parseFloat(getComputedStyle(title).fontSize);
      while(card.scrollHeight>availableHeight && ts>34){
        ts-=2;
        title.style.setProperty("font-size",ts+"px","important");
      }
    }
  });
  if(shouldBroadcast)setTimeout(broadcastProjectorState,0);
}

