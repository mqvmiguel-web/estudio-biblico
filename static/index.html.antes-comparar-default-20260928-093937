async function loadCloudSyncStatus(){
  const label=document.getElementById("syncCloudStatus");
  if(!label)return;

  try{
    const response=await fetch("/api/sync/status");
    const data=await response.json();

    if(!response.ok || !data.ok){
      label.textContent="☁ Google Drive · ❌ Error";
      return;
    }

    const estados={
      sincronizado:"☁ Google Drive · 🟢 Sincronizado",
      subir:"☁ Google Drive · 🟡 Cambios sin subir",
      descargar:"☁ Google Drive · 🔵 Cambios nuevos",
      conflicto:"☁ Google Drive · ⚠️ Conflicto"
    };

    label.textContent=estados[data.estado]||"☁ Google Drive · ❔ Estado desconocido";
  }catch(error){
    label.textContent="☁ Google Drive · ❌ Sin conexión";
  }
}

async function runCloudSync(){
  const button=document.getElementById("syncCloudButton");
  const label=document.getElementById("syncCloudStatus");

  if(!button || !label)return;

  button.disabled=true;
  label.textContent="☁ Google Drive · sincronizando…";

  try{
    const response=await fetch("/api/sync/run",{method:"POST"});
    const data=await response.json();

    if(response.ok && data.ok){
      label.textContent="☁ Google Drive · 🟢 Sincronizado";
      return;
    }

    if(data.estado==="descargar"){
      label.textContent="☁ Google Drive · 🔵 Hay cambios nuevos";
      alert("Hay una versión más nueva en Google Drive.\n\nPor seguridad no se descargará automáticamente sobre este equipo.");
      return;
    }

    if(data.estado==="conflicto"){
      label.textContent="☁ Google Drive · ⚠️ Conflicto";
      alert("Hay cambios tanto en este equipo como en Google Drive.\n\nNo se sobrescribirá ningún dato.");
      return;
    }

    label.textContent="☁ Google Drive · ❌ Error";
    alert(data.mensaje||data.salida||"No fue posible sincronizar.");
  }catch(error){
    label.textContent="☁ Google Drive · ❌ Sin conexión";
  }finally{
    button.disabled=false;
  }
}

