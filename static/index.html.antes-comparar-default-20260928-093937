const APP_THEME_KEY='miEstudioBiblicoTemaV1';
let appThemePreference='auto';
function resolvedAppTheme(preference){return preference==='auto'?(window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light'):preference}
function applyAppTheme(preference,save=false){
  if(!['auto','light','dark'].includes(preference))preference='auto';
  appThemePreference=preference;
  document.documentElement.dataset.theme=resolvedAppTheme(preference);
  let control=document.getElementById('appTheme');if(control)control.value=preference;
  let themeMeta=document.querySelector('meta[name="theme-color"]');if(themeMeta)themeMeta.content=document.documentElement.dataset.theme==='dark'?'#0d1511':'#176b49';
  if(save)localStorage.setItem(APP_THEME_KEY,preference);
}
function setAppTheme(preference){applyAppTheme(preference,true)}
applyAppTheme(localStorage.getItem(APP_THEME_KEY)||'auto');
let appColorScheme=window.matchMedia('(prefers-color-scheme:dark)');
let refreshAutomaticTheme=()=>{if(appThemePreference==='auto')applyAppTheme('auto')};
if(appColorScheme.addEventListener)appColorScheme.addEventListener('change',refreshAutomaticTheme);else appColorScheme.addListener(refreshAutomaticTheme);

