function renderPlanRangeColumn(d,bookId,fromVerse,toVerse){
  let last=toVerse||d.versiculos.length,items=[];
  for(let number=Math.max(1,fromVerse);number<=Math.min(last,d.versiculos.length);number++){
    let text=d.versiculos[number-1]||'—';
    items.push(`<div class="v" data-version="${d.version}" data-book="${bookId}" data-chapter="${d.capitulo}" data-verse="${number}"><button class="verse-number" type="button" onclick="highlightWholeVerse(this)">${number}</button><span class="verse-text">${renderHighlightedVerse(text,d.version,bookId,d.capitulo,number)}</span></div>`)
  }
  return `<div class="version-column"><h2>${escapeHtml(d.libro)} ${d.capitulo}<span class="version-badge">${escapeHtml(d.abreviatura)}</span></h2>${items.join('')}</div>`
}
async function openPlanReadingRange(bookId,startChapter,startVerse,endChapter,endVerse,label){
  try{
    book.value=bookId;fillChapters();chapter.value=String(startChapter);show('bible');
    bibleVersionName.textContent='Cargando la lectura completa…';verses.innerHTML='<div class="plan-range-loading">Preparando '+escapeHtml(label)+'…</div>';
    let primary=bibleVersion.value,versions=compareVersions.checked?[primary,primary==='lbla'?'rvr1960':'lbla']:[primary],blocks=[];
    for(let chapterNumber=startChapter;chapterNumber<=endChapter;chapterNumber++){
      let columns=await Promise.all(versions.map(version=>fetch(`/api/chapter?book=${encodeURIComponent(bookId)}&chapter=${chapterNumber}&version=${version}`).then(async response=>{let data=await response.json();if(!response.ok)throw new Error(data.error||'No se pudo abrir el capítulo');return data})));
      await loadPassageHighlights(versions,bookId,chapterNumber);
      let from=chapterNumber===startChapter?startVerse:1,to=chapterNumber===endChapter?endVerse:0;
      let content=columns.map(data=>renderPlanRangeColumn(data,bookId,from,to)).join('');
      blocks.push(compareVersions.checked?`<div class="comparison-grid plan-range-chapter">${content}</div>`:`<div class="plan-range-chapter">${content}</div>`);
      if(dashboardStarted)registerReading(bookId,chapterNumber,primary)
    }
    bibleVersionName.textContent=label+' · '+(compareVersions.checked?'RVR1960 y LBLA':columnsAbbreviation(primary));
