const CONTEST_STORAGE_KEY="miEstudioBiblicoConcursoSlidesV1";
let bibleContestSlides=loadBibleContestSlides();
let contestEditingIndex=null;

function loadBibleContestSlides(){
  try{
    let saved=JSON.parse(localStorage.getItem(CONTEST_STORAGE_KEY)||"null");
    if(Array.isArray(saved)&&saved.length)return saved;
  }catch(e){}
  return defaultBibleContestSlides.map(x=>({...x}));
}
function saveBibleContestSlides(){localStorage.setItem(CONTEST_STORAGE_KEY,JSON.stringify(bibleContestSlides))}
function ensureContestEditor(){
  let existing=document.getElementById('contestEditorModal');
  if(existing)return existing;
  let modal=document.createElement('div');
  modal.id='contestEditorModal';
  modal.className='contest-editor-modal';
  modal.hidden=true;
  modal.innerHTML=`
    <div class="contest-editor-panel">
      <div class="contest-editor-head">
        <div><strong>🎮 Editor Concurso Bíblico</strong><p class="muted">Agrega, edita y ordena tus preguntas.</p></div>
        <button type="button" onclick="closeContestEditor()">✕</button>
      </div>
      <div class="contest-editor-grid">
        <aside>
          <div class="contest-editor-actions">
            <button type="button" class="primary" onclick="newContestQuestion()">＋ Nueva</button>
            <button type="button" onclick="resetContestQuestions()">↺ Base</button>
          </div>
          <div id="contestQuestionList" class="contest-question-list"></div>
        </aside>
        <section class="contest-form-card">
          <label>Sección / etapa<input id="contestKicker" class="field" placeholder="Ej: GRAN FINAL"></label>
          <label>Título<input id="contestTitle" class="field" placeholder="Ej: PREGUNTA FINAL"></label>
          <label>Texto / pregunta<textarea id="contestText" class="field" placeholder="Escribe la pregunta o instrucciones..."></textarea></label>
          <label>Respuesta privada / jurado<textarea id="contestAnswer" class="field" placeholder="Opcional. Se muestra con 👁 Mostrar respuesta."></textarea></label>
          <div class="contest-editor-actions">
            <button type="button" class="primary" onclick="saveContestQuestionFromForm()">💾 Guardar pregunta</button>
            <button type="button" onclick="duplicateContestQuestion()">⧉ Duplicar</button>
            <button type="button" class="danger" onclick="deleteContestQuestion()">🗑 Eliminar</button>
          </div>
          <p class="muted">Tip: usa Enter doble para separar líneas o instrucciones.</p>
        </section>
      </div>
    </div>`;
  (typeof bibleContestOverlay!=='undefined'&&bibleContestOverlay?bibleContestOverlay:document.body).appendChild(modal);
  return modal;
}
function openContestEditor(){let modal=ensureContestEditor();if(modal.parentElement!==bibleContestOverlay)bibleContestOverlay.appendChild(modal);modal.hidden=false;contestEditingIndex=Math.min(contestSlide,bibleContestSlides.length-1);renderContestEditorList();loadContestQuestionToForm(contestEditingIndex)}
function closeContestEditor(){let modal=document.getElementById('contestEditorModal');if(modal)modal.hidden=true}
function renderContestEditorList(){
  let list=document.getElementById('contestQuestionList');
  if(!list)return;
  list.innerHTML=bibleContestSlides.map((q,i)=>`
    <button type="button" class="contest-question-item ${i===contestEditingIndex?'active':''}" onclick="loadContestQuestionToForm(${i})">
      <span>${i+1}. ${escapeHtml(q.kicker||'Sin sección')}</span>
      <strong>${escapeHtml(q.title||'Sin título')}</strong>
    </button>`).join('');
}
function loadContestQuestionToForm(index){
  contestEditingIndex=Math.max(0,Math.min(bibleContestSlides.length-1,Number(index)||0));
  let q=bibleContestSlides[contestEditingIndex]||{};
  contestKicker.value=q.kicker||'';contestTitle.value=q.title||'';contestText.value=q.text||'';contestAnswer.value=q.answer||'';
  renderContestEditorList();
}
function newContestQuestion(){
  bibleContestSlides.push({kicker:'NUEVA PREGUNTA',title:'Pregunta',text:'',answer:''});
  contestEditingIndex=bibleContestSlides.length-1;saveBibleContestSlides();renderContestEditorList();loadContestQuestionToForm(contestEditingIndex);contestText.focus();
}
function saveContestQuestionFromForm(){
  if(contestEditingIndex===null)newContestQuestion();
  bibleContestSlides[contestEditingIndex]={kicker:contestKicker.value.trim()||'CONCURSO BÍBLICO',title:contestTitle.value.trim()||'Pregunta',text:contestText.value.trim(),answer:contestAnswer.value.trim()};
  saveBibleContestSlides();contestSlide=contestEditingIndex;contestAnswerVisible=false;renderContestEditorList();renderContestSlide();
}
function duplicateContestQuestion(){
  if(contestEditingIndex===null)return;
  bibleContestSlides.splice(contestEditingIndex+1,0,{...bibleContestSlides[contestEditingIndex],title:(bibleContestSlides[contestEditingIndex].title||'Pregunta')+' copia'});
  contestEditingIndex++;saveBibleContestSlides();renderContestEditorList();loadContestQuestionToForm(contestEditingIndex);
}
function deleteContestQuestion(){
  if(contestEditingIndex===null||!bibleContestSlides.length)return;
  if(!confirm('¿Eliminar esta pregunta del concurso?'))return;
  bibleContestSlides.splice(contestEditingIndex,1);
  if(!bibleContestSlides.length)bibleContestSlides=[{kicker:'CONCURSO BÍBLICO',title:'Nueva pregunta',text:'',answer:''}];
  contestEditingIndex=Math.min(contestEditingIndex,bibleContestSlides.length-1);contestSlide=Math.min(contestSlide,bibleContestSlides.length-1);
  saveBibleContestSlides();renderContestEditorList();loadContestQuestionToForm(contestEditingIndex);renderContestSlide();
}
function resetContestQuestions(){
  if(!confirm('¿Restaurar el concurso base? Se perderán cambios personalizados.'))return;
  bibleContestSlides=defaultBibleContestSlides.map(x=>({...x}));contestEditingIndex=0;contestSlide=0;contestAnswerVisible=false;
  saveBibleContestSlides();renderContestEditorList();loadContestQuestionToForm(0);renderContestSlide();
}

function openBibleContest(){
  contestSlide = 0;
  contestAnswerVisible = false;
  resetContestTimer();

  bibleContestOverlay.classList.add("dark","contest-mode");
  bibleContestOverlay.hidden = false;
  document.body.style.overflow = "hidden";

  renderContestSlide();

  bibleContestOverlay.requestFullscreen?.().catch(()=>{});
}

function closeBibleContest(){
  bibleContestOverlay.hidden = true;
  bibleContestOverlay.classList.remove("contest-mode");
  closeContestEditor();
  document.body.style.overflow = "";

  clearInterval(contestTimerHandle);
  contestTimerHandle = null;

  if(document.fullscreenElement){
    document.exitFullscreen().catch(()=>{});
  }
}

function formatContestAnswer(answer){
  let lines=String(answer||"").split(/\n+/).map(x=>x.trim()).filter(Boolean);
  if(!lines.length)return "";
  return lines.map((line,index)=>{
    let m=line.match(/^([^:]{2,28}):\s*(.*)$/);
    if(m){
      let items=m[2].split(/\s*·\s*/).filter(Boolean).map(x=>`<span>${escapeHtml(x)}</span>`).join("");
      return `<div class="contest-answer-row"><b>${escapeHtml(m[1])}</b><div class="contest-answer-chips">${items||escapeHtml(m[2])}</div></div>`;
    }
    return `<div class="contest-answer-intro ${index===0?'first':''}">${escapeHtml(line)}</div>`;
  }).join("");
}

function renderContestSlide(){
  const s = bibleContestSlides[contestSlide] || {};

  let respuesta = "";

  if(contestAnswerVisible && s.answer){
    respuesta = `
      <div class="contest-answer-box">
        <div class="contest-answer-label">✅ Respuesta</div>
        <div class="contest-answer-text">${formatContestAnswer(s.answer)}</div>
      </div>`;
  }

  if(typeof contestAnswerButton!=="undefined"&&contestAnswerButton){
    contestAnswerButton.textContent=contestAnswerVisible?"🙈 Ocultar respuesta":"👁 Mostrar respuesta";
  }

  contestStage.innerHTML = `
    <article class="slide-card ${contestAnswerVisible?'contest-answer-visible':''}">
      <div class="slide-kicker">${escapeHtml(s.kicker || "")}</div>
      <h1>${escapeHtml(s.title || "")}</h1>
      ${s.text ? `<p style="white-space:pre-line">${escapeHtml(s.text)}</p>` : ""}
      ${respuesta}
      <div class="slide-counter">${contestSlide + 1} / ${bibleContestSlides.length}</div>
    </article>`;

  requestAnimationFrame(()=>{
    const card = contestStage.querySelector(".slide-card");
    const text = card?.querySelector("p");
    const title = card?.querySelector("h1");

    if(!card) return;

    if(text) text.style.fontSize = "";
    if(title) title.style.fontSize = "";

    const cs = getComputedStyle(contestStage);
    const available =
      contestStage.clientHeight -
      parseFloat(cs.paddingTop) -
      parseFloat(cs.paddingBottom);

    if(text){
      let size = parseFloat(getComputedStyle(text).fontSize);

      while(card.scrollHeight > available && size > 12){
        size -= 1;
        text.style.fontSize = size + "px";
      }
    }

    if(card.scrollHeight > available && title){
      let size = parseFloat(getComputedStyle(title).fontSize);

      while(card.scrollHeight > available && size > 28){
        size -= 2;
        title.style.fontSize = size + "px";
      }
    }
  });
}

function changeContestSlide(delta){
  contestSlide = Math.max(
    0,
    Math.min(bibleContestSlides.length - 1, contestSlide + delta)
  );

  contestAnswerVisible = false;
  resetContestTimer();
  renderContestSlide();
}

function toggleContestAnswer(){
  const s = bibleContestSlides[contestSlide] || {};

  if(!s.answer) return;

  contestAnswerVisible = !contestAnswerVisible;
  renderContestSlide();
}

function updateContestTimer(){
  contestTimer.textContent = String(contestTimerSeconds);

  if(contestTimerSeconds <= 3){
    contestTimer.style.fontWeight = "900";
    contestTimer.style.transform = "scale(1.15)";
  }else{
    contestTimer.style.fontWeight = "";
    contestTimer.style.transform = "";
  }
}

function startContestTimer(){
  clearInterval(contestTimerHandle);

  contestTimerSeconds = 10;
  updateContestTimer();

  contestTimerHandle = setInterval(()=>{
    contestTimerSeconds--;
    updateContestTimer();

    if(contestTimerSeconds <= 0){
      clearInterval(contestTimerHandle);
      contestTimerHandle = null;
      contestTimer.textContent = "¡TIEMPO!";
    }
  },1000);
}

function resetContestTimer(){
  clearInterval(contestTimerHandle);
  contestTimerHandle = null;
  contestTimerSeconds = 10;

  if(typeof contestTimer !== "undefined" && contestTimer){
    contestTimer.textContent = "10";
    contestTimer.style.fontWeight = "";
    contestTimer.style.transform = "";
  }
}

document.addEventListener("keydown", event=>{
  if(typeof bibleContestOverlay === "undefined" || bibleContestOverlay.hidden) return;

  if(event.key === "Escape"){
    closeBibleContest();
    return;
  }

  if(event.key === "ArrowRight" || event.key === "ArrowDown"){
    changeContestSlide(1);
  }

  if(event.key === "ArrowLeft" || event.key === "ArrowUp"){
    changeContestSlide(-1);
  }

  if(event.key === " "){
    event.preventDefault();
    startContestTimer();
  }

  if(event.key.toLowerCase() === "r"){
    toggleContestAnswer();
  }
});

// CORRECTOR_ORTOGRAFIA_GLOBAL_V1
function activarCorrectorOrtografia(root=document){
  const selector='textarea,input[type="text"],input[type="search"],input:not([type]),[contenteditable="true"]';
  root.querySelectorAll(selector).forEach(el=>{
    if(el.type&&['password','email','url','number','date','time','hidden','file','checkbox','radio','range','color'].includes(el.type))return;
    el.setAttribute('spellcheck','true');
    el.setAttribute('lang','es-CL');
    el.setAttribute('autocomplete',el.getAttribute('autocomplete')||'on');
  });
}

window.addEventListener('DOMContentLoaded',()=>{
  activarCorrectorOrtografia();
  const observer=new MutationObserver(mutations=>{
    for(const mutation of mutations){
      mutation.addedNodes.forEach(node=>{
        if(node.nodeType===1)activarCorrectorOrtografia(node);
      });
    }
  });
  observer.observe(document.body,{childList:true,subtree:true});
});init().catch(e=>alert('Error al iniciar: '+e));
</script>

