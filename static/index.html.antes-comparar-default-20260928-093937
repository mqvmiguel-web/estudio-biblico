      ${!s.text?`<div class="projector-cover"><div class="projector-cover-title">Estudio Bíblico</div><div class="projector-cover-subtitle">${escapeHtml(s.title||"")}</div></div>`:""}
      ${s.text?`<div class="slide-public-content">
        ${String(s.noteKey||"").startsWith("point_")||s.noteKey==="application"?`<div class="projector-point-title">${escapeHtml(s.noteKey==="application"?(s.title||"¿Qué es lo que debo hacer?"):projectorTitle(s.title||s.sectionLabel||""))}</div>`:""}
