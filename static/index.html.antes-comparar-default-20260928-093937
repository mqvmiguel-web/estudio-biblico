function distributePlan(refs,days,offset,stage){let out=[];for(let i=0;i<days;i++){let a=Math.floor(i*refs.length/days),z=Math.floor((i+1)*refs.length/days),part=refs.slice(a,z),cut=Math.ceil(part.length/2);out.push({day:offset+i,stage,morning:part.slice(0,cut),evening:part.slice(cut)})}return out}
