function renderSmartFragmentsV1(fragments){
  if(!fragments?.length)return '<p class="muted">No se encontraron fragmentos.</p>';
  return fragments.map(f=>`<div class="smart-fragment"><small>Página ${Number(f.pagina)||'—'}</small>${escapeHtml(f.fragmento||'')}</div>`).join('');
}

async function prepareSmartAnalysis(){
  if(!activeDocumentId)return;
  const status=document.getElementById('smartAnalysisStatus');
  const box=document.getElementById('smartAnalysisResult');
  status.textContent='Preparando fragmentos localmente…';
  box.hidden=true;
  try{
    const response=await fetch(`/api/documents/${activeDocumentId}/smart-preview`,{method:'POST'});
    const data=await response.json();
    if(!response.ok)throw new Error(data.error||'No se pudo preparar el análisis');
    status.textContent='Preparación local completada ✓';
    box.hidden=false;
    box.innerHTML=`<strong>Preparación para IA</strong>
      <h4>Tema principal provisional</h4><p>${escapeHtml(data.tema_principal_provisional||'')}</p>
      <h4>Punto central provisional</h4><p>${escapeHtml(data.punto_central_provisional||'')}</p>
      ${data.ideas_provisionales?.length?`<h4>Ideas detectadas</h4><ul>${data.ideas_provisionales.map(x=>`<li>${escapeHtml(x)}</li>`).join('')}</ul>`:''}
      <h4>Fragmentos seleccionados (${data.fragmentos?.length||0})</h4>
      <p class="muted">${escapeHtml(data.aviso||'')}</p>
      <details><summary>Ver evidencia preparada</summary>${renderSmartFragmentsV1(data.fragmentos)}</details>`;
  }catch(e){
    status.textContent='Error: '+e.message;
  }
}

async function prepareSmartQuestion(){
  if(!activeDocumentId)return;
  const input=document.getElementById('smartQuestionInput');
  const box=document.getElementById('smartQuestionResult');
  const pregunta=(input?.value||'').trim();
  if(pregunta.length<3)return alert('Escribe una pregunta sobre el documento.');
  box.hidden=false;
  box.innerHTML='<p class="muted">Buscando evidencia local…</p>';
  try{
    const response=await fetch(`/api/documents/${activeDocumentId}/smart-question-preview`,{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({pregunta})
    });
    const data=await response.json();
    if(!response.ok)throw new Error(data.error||'No se pudo buscar');
    box.innerHTML=`<strong>Evidencia encontrada</strong>
      <p class="muted">${escapeHtml(data.aviso||'')}</p>
      <p>${data.paginas?.length?'Páginas: '+data.paginas.join(', '):'Sin páginas identificadas'}</p>
      ${renderSmartFragmentsV1(data.fragmentos)}`;
  }catch(e){
    box.innerHTML='<p>Error: '+escapeHtml(e.message)+'</p>';
  }
}

