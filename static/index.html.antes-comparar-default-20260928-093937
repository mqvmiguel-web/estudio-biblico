function viewerBr(t){return escapeHtml(String(t||"")).replaceAll(String.fromCharCode(10),"<br>")}
function buildMessageViewerHtml(p){
  // VISUALIZAR_MENSAJE_V1: vista de lectura, sin salir del archivo
  let esCopia=isArchiveCopy(p);
  let notes=readPrivateNotes(p.notas_privadas||"");
  let sec=(label,text,key)=>{
    let body=String(text||"").trim(),n=String(notes[key]||"").trim();
    if(!body&&!n)return"";
    let out="";
    if(body)out+='<section class="viewer-section"><h3>'+escapeHtml(label)+'</h3><div class="viewer-text">'+viewerBr(body)+'</div></section>';
    if(n)out+='<div class="viewer-note"><span class="viewer-note-tag">Nota privada</span><div>'+viewerBr(n)+'</div></div>';
    return out;
  };
  let head='<header class="viewer-head"><div><h2>'+escapeHtml(p.titulo||"Sin t\u00edtulo")+'</h2>'
    +(p.texto_base?'<div class="viewer-base">'+escapeHtml(p.texto_base)+'</div>':'')
    +(esCopia?'<div class="viewer-tag">Copia con notas</div>':'')+'</div>'
    +'<button type="button" class="viewer-close-btn" onclick="closeMessageViewer()">Cerrar</button></header>';
  let body='<div class="viewer-body">';
  body+=sec("Idea central",p.idea_central,"idea");
  body+=sec("Introducci\u00f3n",p.introduccion,"intro");
  (p.puntos||[]).forEach((point,index)=>{
    let q=parseMainPoint(point,index);
    body+=sec("Punto "+(index+1)+": "+q.title,q.text,"point_"+(index+1));
  });
  body+=sec("Vers\u00edculos de apoyo",p.versiculos,"verses");
  body+=sec(p.titulo_aplicacion||"Aplicaci\u00f3n",p.aplicacion,"application");
  body+=sec("Conclusi\u00f3n y llamado",p.conclusion,"conclusion");
  if(String(notes.general||"").trim())body+='<div class="viewer-note viewer-note-general"><span class="viewer-note-tag">Notas generales</span><div>'+viewerBr(notes.general)+'</div></div>';
  return head+body+'</div>';
}
async function openMessageViewer(id){
  try{
    let res=await fetch("/api/presentations/"+id),p=await res.json();
    if(!res.ok||!p||p.id===undefined)throw new Error((p&&p.error)||"No se pudo abrir el mensaje");
    closeMessageViewer();
    let ov=document.createElement("div");
    ov.id="messageViewerBox";
    ov.className="message-viewer-overlay";
    ov.innerHTML='<div class="message-viewer">'+buildMessageViewerHtml(p)+'</div>';
    ov.addEventListener("click",e=>{if(e.target===ov)closeMessageViewer()});
    document.body.appendChild(ov);
    document.body.style.overflow="hidden";
  }catch(e){alert("No se pudo abrir el mensaje: "+e.message)}
}
function closeMessageViewer(){
  let ov=document.getElementById("messageViewerBox");
  if(ov)ov.remove();
  if(!preachOverlay||preachOverlay.hidden)document.body.style.overflow="";
}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('messageViewerBox'))closeMessageViewer()});

function isArchiveCopy(row){
  // BORRAR_COPIA_ARCHIVO_V1: solo las copias exportadas se pueden borrar
  return String(row&&row.titulo||"").toLowerCase().includes("copia con notas");
}
async function deleteArchiveCopy(id,title){
  if(!confirm(`¿Borrar la copia “${title}”?\n\nEsto borra solo la copia del archivo.\nTu predicción original en Modo Predicación NO se toca.`))return;
  try{
    let res=await fetch("/api/messages/archive-copy/"+id,{method:"DELETE"}),data=await res.json();
    if(!res.ok){alert(data.error||"No se pudo borrar la copia.");return}
    let maps=readExportCopies();
    for(let key of Object.keys(maps)){if(String(maps[key])===String(id))delete maps[key]}
    writeExportCopies(maps);
    if(String(activePresentation)===String(id))showPresentationEditor(false);
    await loadMessageArchiveV2();
  }catch(e){alert("No se pudo borrar la copia: "+e.message)}
}
function renderMessageArchiveV2(){
  const box=document.getElementById('archiveList');
  if(!box)return;
  const search=document.getElementById('archiveSearch');
  const term=(search?search.value:'').trim().toLocaleLowerCase('es');

  const rows=messageArchiveV2.filter(row=>{
    const points=Array.isArray(row.puntos)?row.puntos.join(' '):'';
    const haystack=[
      row.titulo,row.texto_base,row.idea_central,row.introduccion,
      points,row.versiculos,row.aplicacion,row.conclusion
    ].filter(Boolean).join(' ').toLocaleLowerCase('es');
    return !term || haystack.includes(term);
  });

  const count=document.getElementById('archiveCount');
  if(count)count.textContent=`${rows.length} mensaje${rows.length===1?'':'s'}`;

  if(!rows.length){
    box.innerHTML=term
      ? '<div class="card archive-empty">No encontré mensajes con esa búsqueda.</div>'
      : '<div class="card archive-empty">Aún no hay predicaciones guardadas.</div>';
    return;
  }

  box.innerHTML=rows.map(row=>{
    const title=escapeHtml(row.titulo||'Predicación sin título');
    const base=escapeHtml(row.texto_base||'Sin texto bíblico principal');
    const idea=row.idea_central?escapeHtml(row.idea_central):'';
    const esCopia=isArchiveCopy(row);
    const id=Number(row.id);
    const badge=esCopia?'<span class="muted archive-copy-badge">📋 Copia con notas</span>':'<span class="muted">📺 Predicación</span>';
    const borrar=esCopia?`<button class="danger archive-delete-copy" type="button" onclick="deleteArchiveCopy(${id},'${escapeHtml(row.titulo||'Copia')}')">🗑 Borrar copia</button>`:'';
    const pie=esCopia?'Copia guardada desde Modo Predicación':'Guardado en Modo Predicación';
    return `<article class="card archive-message-card ${esCopia?'archive-is-copy':''}">
      <div class="archive-message-head">
        <div>
          <h2>${title}</h2>
          <div class="archive-message-base">${base}</div>
        </div>
        ${badge}
      </div>
      ${idea?`<p class="archive-message-idea">${idea}</p>`:''}
      <div class="archive-message-footer">
        <span class="muted">${pie}</span>
        <div class="archive-message-actions">
          <button class="primary-ghost" type="button" onclick="openMessageViewer(${id})">👁 Visualizar</button><button type="button" onclick="openArchivedPresentationV2(${id})">✏️ Abrir / Editar</button>
          <button class="primary" type="button" onclick="preachArchivedPresentationV2(${id})">📖 Predicar</button>
          ${borrar}
        </div>
      </div>
    </article>`;
  }).join('');
}

